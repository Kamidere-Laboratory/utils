{
  "name": "@kamidere/utils",
  "private": false,
  "packageManager": "pnpm@8.6.2",
  "devDependencies": {
    "@changesets/cli": "^2.26.2",
    "@commitlint/cli": "^17.7.1",
    "@commitlint/config-conventional": "^17.7.0",
    "ava": "^5.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^8.0.3",
    "turbo": "^1.10.13"
  },
  "config": {
